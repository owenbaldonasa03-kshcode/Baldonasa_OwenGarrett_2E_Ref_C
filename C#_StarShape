using System;
using System.Collections.Generic;

namespace StarShape
{
    class Program
    {
        // Grid bounds
        const int GridWidth = 61;   // Center Column is 30
        const int GridHeight = 31;  // Center Row is 15

        static void Main(string[] args)
        {
            char[,] grid = new char[GridHeight, GridWidth];
            
            // Initialize the grid with empty spaces
            for (int r = 0; r < GridHeight; r++)
            {
                for (int c = 0; c < GridWidth; c++)
                {
                    grid[r, c] = ' ';
                }
            }

            double centerX = GridWidth / 2.0;
            double centerY = GridHeight / 2.0;
            double outerRadius = (GridHeight / 2.0) - 1;
            double innerRadius = outerRadius * 0.4;

            // Generate vertices for a 5-pointed star
            List<(double x, double y)> starVertices = GetStarVertices(centerX, centerY, outerRadius, innerRadius, 5);

            // Connect the vertices sequentially to outline the star
            for (int i = 0; i < starVertices.Count; i++)
            {
                var start = starVertices[i];
                // Connect the last vertex back to the first vertex
                var end = starVertices[(i + 1) % starVertices.Count]; 
                DrawLine(grid, start, end);
            }

            PrintGrid(grid);
        }

        static List<(double x, double y)> GetStarVertices(double centerX, double centerY, double outerRadius, double innerRadius, int points)
        {
            var vertices = new List<(double x, double y)>();
            int totalPoints = points * 2;
            
            // Angle step between alternating inner and outer vertices
            double angleStep = Math.PI / points; 
            double startAngle = -Math.PI / 2.0; // Point straight up

            for (int i = 0; i < totalPoints; i++)
            {
                // Alternate between outer points and inner valleys
                double radius = (i % 2 == 0) ? outerRadius : innerRadius;
                double angle = startAngle + (angleStep * i);
                
                // Multiply X by 2.0 to compensate for terminal font aspect ratios (tall characters)
                double x = centerX + (Math.Cos(angle) * radius * 2.0);
                double y = centerY + (Math.Sin(angle) * radius);

                vertices.Add((x, y));
            }
            return vertices;
        }

        static void DrawLine(char[,] grid, (double x, double y) start, (double x, double y) end)
        {
            // Determine steps based on the longest axis delta
            int steps = (int)Math.Max(Math.Abs(end.x - start.x), Math.Abs(end.y - start.y)) + 1;

            for (int i = 0; i <= steps; i++)
            {
                double t = (double)i / steps;
                
                // Interpolate coordinate points
                int x = (int)Math.Round(start.x + (end.x - start.x) * t);
                int y = (int)Math.Round(start.y + (end.y - start.y) * t);

                // Boundary check to protect array limits before plotting
                if (x >= 0 && x < GridWidth && y >= 0 && y < GridHeight)
                {
                    grid[y, x] = '*';
                }
            }
        }

        static void PrintGrid(char[,] grid)
        {
            for (int r = 0; r < GridHeight; r++)
            {
                for (int c = 0; c < GridWidth; c++)
                {
                    Console.Write(grid[r, c]);
                }
                Console.WriteLine();
            }
        }
    }
}
